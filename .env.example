# 3DBuildBot environment variables
# Copy this file to .env.local (which is gitignored) and fill in your keys.

# --- AI (Google Gemini) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Payments (Stripe) — Phase 2, not needed to run the site ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Auth (Clerk) — Phase 2 ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Database (Supabase) — Phase 2 ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend) — Phase 2 ---
RESEND_API_KEY=
